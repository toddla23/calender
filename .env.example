# ===== 바탕 달력 서버 설정 =====
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env && chmod 600 .env
# 인터넷(Tailscale Funnel)에 공개되는 서비스입니다. 아래 비밀값은 절대 공유하지 마세요.

# 외부에서 접속하는 주소 (Funnel). Google OAuth 리디렉션 URI 도 이 주소 기준입니다.
PUBLIC_URL=https://raspberry-pi.tailb6b7a3.ts.net

# --- MariaDB (호스트에 설치된 것) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=deskcal
DB_USER=deskcal
DB_PASSWORD=여기에_DB_비밀번호

# --- Google 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID, 유형: 웹 애플리케이션)
# 승인된 리디렉션 URI: https://raspberry-pi.tailb6b7a3.ts.net/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인을 허용할 Google 이메일 (쉼표로 구분). 비어 있으면 서버가 시작되지 않습니다.
ALLOWED_EMAILS=you@gmail.com
# 임시공휴일 편집 권한 (비우면 ALLOWED_EMAILS 전체)
ADMIN_EMAILS=

# --- 백업 ---
# 매일 BACKUP_HOUR 시에 ./backups 에 저장, 최근 BACKUP_KEEP 개 보관
BACKUP_HOUR=4
BACKUP_KEEP=30

# --- 기타 ---
# 날짜 칸당 보관할 이력 개수
HISTORY_KEEP=100
LOG_LEVEL=info
# 컨테이너 실행 사용자 (./backups 쓰기 권한). 파이 기본 사용자는 1000
PUID=1000
PGID=1000

# --- Android 앱(TWA) ---
# 플레이스토어에 올려 "Play 앱 서명"을 쓰면 Play Console > 앱 무결성에 나오는 SHA-256 지문을 여기에 추가 (쉼표 구분)
ANDROID_CERT_SHA256=
