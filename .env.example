# docker compose용 환경변수. 복사해서 .env로 사용 (.env는 git 제외)
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# 32바이트 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# 쉼표로 구분한 Google OAuth 클라이언트 ID (웹/Electron/Android/iOS)
GOOGLE_CLIENT_IDS=
# 공공데이터포털 특일 정보 API 서비스 키
HOLIDAY_API_KEY=
# 외부 공개 도메인 (DDNS). Caddy가 이 도메인으로 HTTPS 인증서를 발급
DOMAIN=calendar.example.duckdns.org
