<?xml version="1.0" encoding="utf-8"?>
<!-- 월 달력 위젯 (F19). 칸은 MonthWidgetProvider 가 widget_month_row/cell 로 채운다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/widget_month_label"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/prev"
            style="@style/WidgetIconButton"
            android:contentDescription="이전 달"
            android:text="‹" />

        <TextView
            android:id="@+id/next"
            style="@style/WidgetIconButton"
            android:contentDescription="다음 달"
            android:text="›" />

        <TextView
            android:id="@+id/refresh"
            style="@style/WidgetIconButton"
            android:contentDescription="새로고침"
            android:text="⟳" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView style="@style/WidgetDow" android:text="일" android:textColor="@color/widget_sun" />
        <TextView style="@style/WidgetDow" android:text="월" />
        <TextView style="@style/WidgetDow" android:text="화" />
        <TextView style="@style/WidgetDow" android:text="수" />
        <TextView style="@style/WidgetDow" android:text="목" />
        <TextView style="@style/WidgetDow" android:text="금" />
        <TextView style="@style/WidgetDow" android:text="토" android:textColor="@color/widget_sat" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <include layout="@layout/widget_unlinked" />
</LinearLayout>
