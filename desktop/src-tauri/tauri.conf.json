{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BatangCalendar",
  "mainBinaryName": "batang-calendar",
  "version": "0.3.0",
  "identifier": "dev.selfhosted.batangcalendar",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "바탕 달력",
        "width": 900,
        "height": 640,
        "minWidth": 360,
        "minHeight": 280,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "resizable": true,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication --disable-background-networking --renderer-process-limit=1 --disable-gpu-shader-disk-cache"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "바탕 달력",
    "longDescription": "셀프호스팅 서버와 실시간 동기화되는 바탕화면 달력",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
