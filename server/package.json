{
  "name": "deskcal-server",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "bundle": "esbuild src/index.ts src/backup-cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=bundle --out-extension:.js=.mjs --legal-comments=none --minify-syntax --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "mysql2": "^3.24.6",
    "postgrator": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.23.0"
  }
}
